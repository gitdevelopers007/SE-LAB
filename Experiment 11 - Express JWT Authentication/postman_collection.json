{
  "info": {
    "_postman_id": "exp11-jwt-auth-collection",
    "name": "Experiment 11 - JWT Authorized Student API",
    "description": "Postman Collection for Experiment 11: Securing Student CRUD Endpoints with JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. User Login (Obtain JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.environment.set(\"jwt_token\", jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:3011/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3011",
          "path": ["api", "auth", "login"]
        },
        "description": "Logs in and returns a signed JSON Web Token (JWT)."
      },
      "response": []
    },
    {
      "name": "2. Get Protected Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:3011/api/auth/profile",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3011",
          "path": ["api", "auth", "profile"]
        },
        "description": "Fetches current decoded JWT token payload."
      },
      "response": []
    },
    {
      "name": "3. Get Students (Authorized)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:3011/api/students",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3011",
          "path": ["api", "students"]
        },
        "description": "Fetch all students with JWT header."
      },
      "response": []
    },
    {
      "name": "4. Create Student (Authorized)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Meera Nambiar\",\n  \"email\": \"meera@example.com\",\n  \"course\": \"Cybersecurity\",\n  \"grade\": \"A+\",\n  \"gpa\": 9.5\n}"
        },
        "url": {
          "raw": "http://localhost:3011/api/students",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3011",
          "path": ["api", "students"]
        },
        "description": "Create student record securely."
      },
      "response": []
    },
    {
      "name": "5. Test Unauthorized Access (Missing Token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3011/api/students",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3011",
          "path": ["api", "students"]
        },
        "description": "Demonstrates 401 Unauthorized when Bearer token is omitted."
      },
      "response": []
    }
  ]
}
